# Image and build metadata
FLUXGATE_IMAGE=ghcr.io/heartbtz/fluxgate
FLUXGATE_VERSION=latest
FLUXGATE_BUILD_TIME=unknown

# Public HTTP endpoint
BASE_URL=http://localhost:8080
BIND_ADDRESS=127.0.0.1
PORT=8080

# Required secrets: generate unique values before starting
DB_PASSWORD=
JWT_SECRET=
HMAC_SECRET=

# Initial administrator: set ADMIN_PASSWORD only for the first successful start,
# then remove it from .env after the account exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Reverse proxy and request limits
FLUXGATE_TRUSTED_PROXIES=
FLUXGATE_CORS_ORIGIN=
FLUXGATE_MAX_CONCURRENT_DL=100
FLUXGATE_MAX_CONCURRENT_UPLOADS=16
FLUXGATE_LOG_LEVEL=info

# Storage: local or s3
STORAGE_BACKEND=local
STORAGE_MIN_FREE_BYTES=1073741824
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=fluxgate-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true
S3_FORCE_PATH_STYLE=true
